    "configure_mpi": "cmake -S . -B build-rc-mpi -G \"MinGW Makefiles\" -DCMAKE_BUILD_TYPE=Release -DWCNS_ENABLE_MPI=ON -DWCNS_ENABLE_CGNS=ON -DWCNS_BUILD_TESTS=ON",
    "build": "cmake --build <build-rc-serial|build-rc-mpi>",
    "ctest": "ctest --test-dir <build-rc-serial|build-rc-mpi> --output-on-failure",
    "freestream": "python -B tools/run_release_matrix.py --ranks 1,2,4,8 --steps 10 plus the profile/grid/zone parameters recorded below",
    "vortex": "python -B tools/run_vortex_matrix.py --ranks 4 --resolutions 32,64,128 --end-time 10 --cfl 0.5 --minimum-finest-order 3.5 --finest-l1 2e-5 plus each profile/reconstruction below",
    "vortex_rank_consistency": "python -B tools/run_vortex_matrix.py --ranks 1,2,4,8 --resolutions 32 --end-time 10 --cfl 0.5",
    "sod": "python -B tools/run_shock_matrix.py --case sod --cells-i 400 --cells-j 40 --end-time 0.2 --cfl 0.4 --density-l1 0.025 --position-cells 3 plus each reconstruction/Riemann combination below",
    "quadrant": "python -B tools/run_shock_matrix.py --case quadrant --ranks 1,2,4 --cells-i 200 --cells-j 200 --end-time 0.3 --cfl 0.4 --symmetry-l1 5e-4",
    "couette": "python -B tools/run_viscous_matrix.py --case couette --ranks 1,2,4 --cells-i 32 --cells-j 64 --velocity-curvature 0 --cfl 0.5 --l2-absolute 2e-5 --linf-absolute 2e-4 --profile-l2 2e-4",
    "conduction": "python -B tools/run_viscous_matrix.py --case conduction --cells-i 32 --cells-j 64 --profile-l2 2e-5 plus HLLC/Roe coverage",
    "source": "python -B tools/run_source_matrix.py --ranks 1,2,4 --resolution 32 --end-time 0.1 --tolerance 2e-12",
    "manufactured_3d": "python -B tools/run_manufactured_matrix.py --ranks 1,2,4,8 --dimension 3 --cells-i 32 --cells-j 32 --cells-k 32 --warp 0.05 --end-time 0.01 --minimum-steps 5",
    "output_restart": "python -B tools/run_output_restart_matrix.py --restart-ranks 1,2,4 --continuous-steps 100 --checkpoint-step 40 --tolerance 2e-11",
    "failure": "python -B tools/run_failure_matrix.py --ranks 1,2,4 --timeout 30",
    "install": "cmake --install build-rc-mpi --prefix build-rc-install"
  },
