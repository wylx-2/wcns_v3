schema_version = 1
case.name = @CASE_NAME@
mesh.path = @MESH_PATH@
algorithm.profile = @ALGORITHM_PROFILE@
algorithm.reconstruction = mdcd_hybrid
algorithm.reconstruction_variables = characteristic
algorithm.riemann = roe
gas.gamma = 1.4
gas.specific_gas_constant = 1.0
reference.velocity = 1.0
reference.density = 1.0
reference.temperature = 1.0
reference.length = 1.0
reference.viscosity = 0.01
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = @MIN_CELLS@
initial.type = manufactured_periodic
initial.beta = 0.01
initial.background_u = 0.2
initial.background_v = 0.1
boundary.default = outflow
source.enabled = true
source.models = manufactured
source.manufactured.rho = 0.001
source.manufactured.momentum_x = -0.002
source.manufactured.momentum_y = 0.003
source.manufactured.momentum_z = @SOURCE_MOMENTUM_Z@
source.manufactured.energy = 0.004
run.mode = unsteady
run.viscous = false
run.cfl = @CFL@
run.max_steps = 1000000
run.t_end = @END_TIME@
output.directory = @OUTPUT_DIRECTORY@
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = both
output.field.write_initial = false
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T,rho_u,rho_v,rho_w,rho_E,jacobian
output.history.enabled = true
output.history.format = tecplot
output.history.every_steps = 5
output.history.write_initial = true
output.history.write_final = true
output.statistics.enabled = true
output.statistics.format = txt
output.statistics.every_steps = 5
output.statistics.write_initial = true
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_momentum_y,total_momentum_z,total_energy
output.checkpoint.enabled = false
