schema_version = 1
case.name = @CASE_NAME@
mesh.path = @MESH_PATH@
algorithm.profile = phenglei_wcns
algorithm.reconstruction = mdcd_hybrid
algorithm.reconstruction_variables = characteristic
algorithm.riemann = roe
gas.gamma = 1.4
gas.specific_gas_constant = 1.0
reference.velocity = 1.0
reference.density = 1.0
reference.temperature = 1.0
reference.length = 1.0
reference.viscosity = 0.01
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 4
initial.type = manufactured_periodic
initial.beta = 0.01
initial.background_u = 0.2
initial.background_v = 0.1
boundary.default = farfield
source.enabled = true
source.models = manufactured
source.manufactured.rho = 0.001
source.manufactured.momentum_x = -0.002
source.manufactured.momentum_y = 0.003
source.manufactured.momentum_z = @SOURCE_MOMENTUM_Z@
source.manufactured.energy = 0.004
run.mode = unsteady
run.viscous = false
run.cfl = 0.1
run.max_steps = @MAX_STEPS@
run.t_end = 10.0
output.directory = @OUTPUT_DIRECTORY@
output.allow_existing = false
output.dimensional = false
output.field.enabled = @FIELD_ENABLED@
output.field.format = @FIELD_FORMAT@
output.field.every_steps = @FIELD_EVERY_STEPS@
output.field.every_time = @FIELD_EVERY_TIME@
@FIELD_EXPLICIT_LINE@
output.field.write_initial = @FIELD_WRITE_INITIAL@
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T,rho_u,rho_v,rho_w,rho_E,sound_speed,mach,total_enthalpy,entropy_proxy,viscosity,jacobian
output.history.enabled = @HISTORY_ENABLED@
output.history.format = @HISTORY_FORMAT@
output.history.every_steps = 1
output.history.write_initial = true
output.history.write_final = true
output.statistics.enabled = @STATISTICS_ENABLED@
output.statistics.format = @STATISTICS_FORMAT@
output.statistics.every_steps = 1
output.statistics.write_initial = true
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_momentum_y,total_momentum_z,total_energy
output.checkpoint.enabled = @CHECKPOINT_ENABLED@
output.checkpoint.every_steps = @CHECKPOINT_EVERY_STEPS@
output.checkpoint.write_initial = false
output.checkpoint.write_final = true
@RESTART_LINE@
