schema_version = 1
case.name = @CASE_NAME@
mesh.path = @MESH_PATH@
algorithm.profile = @ALGORITHM_PROFILE@
algorithm.reconstruction = @RECONSTRUCTION@
algorithm.reconstruction_variables = characteristic
algorithm.riemann = @RIEMANN@
gas.gamma = 1.4
gas.specific_gas_constant = 1.0
reference.velocity = 1.0
reference.density = 1.0
reference.temperature = 1.0
reference.length = 1.0
reference.viscosity = 0.01
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = @MIN_CELLS@
initial.type = uniform
initial.rho = 1.0
initial.u = 0.1
initial.v = -0.05
initial.w = 0.0
initial.temperature = 1.0
boundary.default = farfield
source.enabled = true
source.models = uniform_conservative
source.uniform.rho = 0.01
source.uniform.momentum_x = 0.02
source.uniform.momentum_y = -0.01
source.uniform.momentum_z = 0.0
source.uniform.energy = 0.03
run.mode = unsteady
run.viscous = false
run.cfl = @CFL@
run.max_steps = 1000000
run.t_end = @END_TIME@
output.directory = @OUTPUT_DIRECTORY@
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.write_initial = false
output.field.write_final = true
output.field.quantities = rho,u,v,w,p,T,rho_u,rho_v,rho_w,rho_E
output.history.enabled = true
output.history.format = txt
output.history.every_steps = 10
output.history.write_initial = true
output.history.write_final = true
output.statistics.enabled = true
output.statistics.format = txt
output.statistics.every_steps = 10
output.statistics.write_initial = true
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_momentum_y,total_energy
output.checkpoint.enabled = false
