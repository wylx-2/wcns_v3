schema_version = 1
case.name = @CASE_NAME@
mesh.path = @MESH_PATH@
algorithm.profile = @ALGORITHM_PROFILE@
algorithm.reconstruction = weno_z
algorithm.reconstruction_variables = characteristic
algorithm.riemann = @RIEMANN@
gas.gamma = 1.4
gas.specific_gas_constant = 1.0
reference.velocity = 1.0
reference.density = 1.0
reference.temperature = 1.0
reference.length = 1.0
reference.viscosity = @REFERENCE_VISCOSITY@
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = @MIN_CELLS@
initial.type = @INITIAL_TYPE@
initial.y0 = 0.0
initial.y1 = 1.0
initial.lower_velocity = @LOWER_VELOCITY@
initial.upper_velocity = @UPPER_VELOCITY@
initial.velocity_curvature = @VELOCITY_CURVATURE@
initial.lower_temperature = @LOWER_TEMPERATURE@
initial.upper_temperature = @UPPER_TEMPERATURE@
initial.temperature_curvature = @TEMPERATURE_CURVATURE@
initial.pressure = 1.0
boundary.default = no_slip_isothermal_wall
boundary.bottom.wall_velocity_x = @LOWER_VELOCITY@
boundary.bottom.wall_temperature = @LOWER_TEMPERATURE@
boundary.top.wall_velocity_x = @UPPER_VELOCITY@
boundary.top.wall_temperature = @UPPER_TEMPERATURE@
source.enabled = false
run.mode = steady
run.viscous = true
run.cfl = @CFL@
run.max_steps = @MAX_STEPS@
steady.min_steps = @MIN_STEPS@
steady.check_interval_steps = @CHECK_INTERVAL@
steady.consecutive_checks = @CONSECUTIVE_CHECKS@
steady.reference_floor = 1.0e-30
steady.l2_absolute = @L2_ABSOLUTE@
steady.l2_relative = @L2_RELATIVE@
steady.linf_enabled = true
steady.linf_absolute = @LINF_ABSOLUTE@
steady.linf_relative = @LINF_RELATIVE@
output.directory = @OUTPUT_DIRECTORY@
output.allow_existing = false
output.dimensional = false
output.field.enabled = true
output.field.format = cgns
output.field.write_initial = false
output.field.write_final = true
output.field.quantities = rho,u,v,p,T,rho_u,rho_v,rho_w,rho_E,viscosity
output.history.enabled = true
output.history.format = txt
output.history.every_steps = @CHECK_INTERVAL@
output.history.write_initial = true
output.history.write_final = true
output.statistics.enabled = true
output.statistics.format = txt
output.statistics.every_steps = @CHECK_INTERVAL@
output.statistics.write_initial = true
output.statistics.write_final = true
output.statistics.quantities = total_mass,total_momentum_x,total_energy
output.checkpoint.enabled = false
