schema_version = 1
case.name = cylinder-o-grid-smoke
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/cylinder_o_smoke.cgns
algorithm.profile = scmm6_wcns
algorithm.reconstruction = zero_order
algorithm.reconstruction_variables = conservative
algorithm.riemann = rusanov
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 69.4001887736
reference.density = 1.0
reference.temperature = 300.0
reference.length = 1.0
reference.viscosity = 3.47000943868
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 8
initial.type = uniform
initial.rho = 1.0
initial.u = 1.0
initial.v = 0.0
initial.w = 0.0
initial.temperature = 1.0
boundary.default = farfield
boundary.cylinder.type = slip_wall
boundary.farfield.type = farfield
source.enabled = false
run.mode = unsteady
run.viscous = false
run.cfl = 0.1
run.max_steps = 2
run.t_end = 0.001
run.max_wall_time = 0
output.directory = @CMAKE_CURRENT_BINARY_DIR@/cylinder-o-grid-smoke
output.allow_existing = true
output.dimensional = false
output.field.enabled = false
output.history.enabled = false
output.statistics.enabled = false
output.boundary.enabled = true
output.boundary.format = txt
output.boundary.every_steps = 0
output.boundary.write_initial = true
output.boundary.write_final = true
output.boundary.patches = cylinder
output.boundary.quantities = p_w,T_w,mu_w,Cp,pressure_traction_x,pressure_traction_y,traction_x,traction_y
output.boundary.reference_pressure = 17.8571428759968
output.boundary.reference_density = 1.0
output.boundary.reference_velocity_x = 1.0
output.boundary.reference_velocity_y = 0.0
output.boundary.reference_velocity_z = 0.0
output.boundary.reference_area = 2.0
output.boundary.reference_length = 1.0
output.boundary.moment_center_x = 0.0
output.boundary.moment_center_y = 0.0
output.boundary.moment_center_z = 0.0
output.boundary.drag_direction_x = 1.0
output.boundary.drag_direction_y = 0.0
output.boundary.drag_direction_z = 0.0
output.boundary.lift_direction_x = 0.0
output.boundary.lift_direction_y = 1.0
output.boundary.lift_direction_z = 0.0
output.boundary.tangent_direction_x = 0.0
output.boundary.tangent_direction_y = 1.0
output.boundary.tangent_direction_z = 0.0
output.checkpoint.enabled = false
