schema_version = 1
case.name = @WCNS_VISCOUS_CASE@
mesh.path = @CMAKE_CURRENT_BINARY_DIR@/generated_periodic_2d.cgns
algorithm.profile = phenglei_wcns
algorithm.reconstruction = weno_z
algorithm.reconstruction_variables = characteristic
algorithm.riemann = hllc
gas.gamma = 1.4
gas.molar_mass = 0.029
reference.velocity = 340.0
reference.density = 1.225
reference.temperature = 288.15
reference.length = 1.0
reference.viscosity = 1.7894e-5
partition.mode = auto_split
partition.allow_idle_ranks = false
partition.max_load_ratio = 1.2
partition.min_cells_per_active_direction = 4
initial.type = @WCNS_VISCOUS_INITIAL@
initial.y0 = 0.0
initial.y1 = 1.0
initial.lower_velocity = @WCNS_VISCOUS_LOWER_U@
initial.upper_velocity = @WCNS_VISCOUS_UPPER_U@
initial.lower_temperature = @WCNS_VISCOUS_LOWER_T@
initial.upper_temperature = @WCNS_VISCOUS_UPPER_T@
initial.temperature_curvature = 0.0
initial.pressure = 1.0
boundary.default = no_slip_isothermal_wall
boundary.left-jmin.wall_velocity_x = @WCNS_VISCOUS_LOWER_U@
boundary.left-jmin.wall_temperature = @WCNS_VISCOUS_LOWER_T@
boundary.right-jmin.wall_velocity_x = @WCNS_VISCOUS_LOWER_U@
boundary.right-jmin.wall_temperature = @WCNS_VISCOUS_LOWER_T@
boundary.left-jmax.wall_velocity_x = @WCNS_VISCOUS_UPPER_U@
boundary.left-jmax.wall_temperature = @WCNS_VISCOUS_UPPER_T@
boundary.right-jmax.wall_velocity_x = @WCNS_VISCOUS_UPPER_U@
boundary.right-jmax.wall_temperature = @WCNS_VISCOUS_UPPER_T@
source.enabled = false
run.mode = steady
run.viscous = true
run.cfl = 0.1
run.max_steps = 1
steady.min_steps = 1
steady.consecutive_checks = 1
steady.l2_absolute = 1.0e-8
steady.linf_enabled = false
output.directory = @CMAKE_CURRENT_BINARY_DIR@/@WCNS_VISCOUS_CASE@
output.allow_existing = true
output.dimensional = false
output.field.enabled = false
output.history.enabled = false
output.statistics.enabled = false
output.checkpoint.enabled = false
